            "post_delay":1
        },
        "next":[
            "event_entry",
            "event_entry_dark",
            "event_get_result"
        ]
    },
    "event_make_choice":{
        "recognition":"template_match",
        "action":"event_make_choice",
        "params":{
            "template":"event_choices",
            "post_delay":1
        },
        "next":[
            "event_entry",
            "event_entry_dark",
            "event_get_result"
        ]
    },
    "event_entry_dark":{
        "recognition":"template_match",
        "action":"click",
        "params":{
