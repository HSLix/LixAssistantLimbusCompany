{
    "event_entry":{
        "recognition":"template_match",
        "action":"click",
        "params":{
            "template":"event_skip",
            "post_delay":1
        },
        "next":[
            "event_pass_check",
            "event_make_choice",
            "event_entry_dark",
            "event_get_result"
        ]
    },
    "event_pass_check":{
        "recognition":"template_match",
